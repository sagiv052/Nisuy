# Telegram bot token from @BotFather
BOT_TOKEN=put-your-bot-token-here

# Telegram app credentials from https://my.telegram.org/apps
API_ID=2259945
API_HASH=put-your-api-hash-here

# Server
PORT=8000
# BASE_URL=http://localhost:8000
# CORS_ORIGINS=https://your-app.example.com

# Access control
# The owner ID 5699704187 is built into the application.
# ADMIN_USER_IDS=123456789,987654321
LEAVE_UNAPPROVED_CHATS=1

# Storage
CATALOG_DB=catalog.db
# Server-side signed Cloudinary connection. Keep this secret out of Git.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or define these three variables separately (recommended on Render):
# CLOUDINARY_API_KEY=<api_key>
# CLOUDINARY_API_SECRET=<api_secret>
# CLOUDINARY_CLOUD_NAME=<cloud_name>
# CLOUDINARY_FOLDER=telegram-stream-bot
# CLOUDINARY_CHUNK_SIZE=20971520

# Optional TMDB metadata completion
# TMDB_READ_ACCESS_TOKEN=put-your-tmdb-read-token-here
# TMDB_API_KEY=put-your-tmdb-api-key-here

# Streaming limits
MAX_ACTIVE_STREAMS=2
STREAM_CACHE_MB=32
STREAM_CACHE_TTL=90
STREAM_READ_AHEAD=0
